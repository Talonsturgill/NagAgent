{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd NagAgent-Backend-Python && pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd NagAgent-Backend-Python && uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "envVars": {
    "PYTHON_VERSION": "3.11",
    "PORT": "8000"
  }
}