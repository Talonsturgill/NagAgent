# NagAgent Backend Environment Variables
# Copy this file to .env and update the values for your environment

# Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://nagent:nagentpass@localhost:5432/nagentdb

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Security & JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API (for roast generation)
OPENAI_API_KEY=your-openai-api-key-here

# Rate Limiting
RATE_LIMIT_ENABLED=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Email Configuration (for future email verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@nagent.app

# Twilio Configuration (for SMS - legacy support)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Application Configuration
APP_NAME=NagAgent
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# Monitoring & Analytics
SENTRY_DSN=https://your-sentry-dsn-here

# File Upload (for future features)
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Subscription & Payment (for future premium features)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Push Notifications (for iOS app)
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=com.yourcompany.nagent
APNS_PRIVATE_KEY_PATH=./apns_key.p8
APNS_USE_SANDBOX=true