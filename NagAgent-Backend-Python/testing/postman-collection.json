  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set environment-specific base URL",
          "const environment = pm.environment.get('environment') || 'production';",
          "let baseUrl;",
          "",
          "switch(environment) {",
          "    case 'local':",
          "        baseUrl = pm.collectionVariables.get('local_url');",
          "        break;",
          "    case 'staging':",
          "        baseUrl = pm.collectionVariables.get('staging_url');",
          "        break;",
          "    default:",
          "        baseUrl = pm.collectionVariables.get('base_url');",
          "}",
          "",
          "pm.collectionVariables.set('base_url', baseUrl);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test to check response time",
          "pm.test(\"Response time is less than 1000ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});",
          "",
          "// Global test to check for proper JSON response (when applicable)",
          "if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
          "    pm.test(\"Response is valid JSON\", function () {",
          "        pm.response.to.be.json;",
          "    });",
          "}"
        ]
      }
    }
  ]
